# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing. These must never be committed: the keystore is the only
# thing that lets you ship an update to an already-installed copy of the app,
# and key.properties holds its passwords in the clear.
/android/key.properties
/android/*.jks
/android/*.keystore

# Captured device logs from tools/field-test.ps1
/test-logs/

# Local Android SDK path, machine specific
/android/local.properties
